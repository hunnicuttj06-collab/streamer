# Copy this file to .env and fill in the values.
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_CHANNEL=-1001234567890
# Optional. If omitted, the app requests your phone number when Telegram needs it.
# TELEGRAM_PHONE_NUMBER=+15551234567
# Optional. Leave unset to have a private access token generated and saved to the persistent data volume.
# PLAYER_ACCESS_TOKEN=replace-with-at-least-32-random-characters
# Set to the URL recipients can reach (LAN IP for local sharing or HTTPS domain for remote sharing).
PLAYER_PUBLIC_BASE_URL=https://player.example.com
# Set this to a domain whose DNS points to this computer/server.
PLAYER_DOMAIN=player.example.com
